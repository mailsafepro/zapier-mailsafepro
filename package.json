{
  "name": "zapier-mailsafepro-integration",
  "version": "1.0.0",
  "description": "Integración empresarial TOP 1% para Zapier con MailSafePro API - Sistema avanzado de validación de emails con autenticación dual, métricas en tiempo real, detección de spam traps y análisis de calidad.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "jest --verbose --runInBand --no-cache",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "validate": "zapier validate",
    "build": "zapier build",
    "deploy": "zapier push",
    "docs": "zapier describe",
    "check": "npm run lint && npm run test:coverage",
    "prepublishOnly": "npm run check",
    "prepare": "husky install"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "zapier-platform-core": "18.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^2.8.8"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/test/**",
      "!**/coverage/**",
      "!jest.config.js",
      "!.eslintrc.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./test/setup.js"
    ],
    "testTimeout": 30000,
    "verbose": true,
    "forceExit": true,
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true
  },
  "zapier": {
    "platformVersion": "18.0.1",
    "concurrency": 10,
    "throttle": {
      "minTimeout": 1000,
      "maxTimeout": 60000,
      "randomize": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": {
    "name": "MailSafePro Team",
    "email": "mailsafepro1@gmail.com",
    "url": "https://mailsafepro.com"
  },
  "contributors": [
    {
      "name": "MailSafePro Engineering",
      "email": "mailsafepro1@gmail.com"
    }
  ],
  "license": "MIT",
  "keywords": [
    "zapier",
    "integration",
    "email-validation",
    "email-verification",
    "email-security",
    "spam-trap-detection",
    "email-quality",
    "deliverability",
    "email-api",
    "enterprise",
    "mail-safety",
    "email-hygiene"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mailsafepro/zapier-integration"
  },
  "bugs": {
    "url": "https://github.com/mailsafepro/zapier-integration/issues"
  },
  "homepage": "https://docs.mailsafepro.com/integrations/zapier",
  "files": [
    "index.js",
    "authentication.js",
    "triggers/",
    "creates/",
    "searches/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
